{
  "name": "hevy-coach-mcp",
  "version": "0.4.1",
  "description": "MCP server for Hevy: live training analytics — e1RM, PRs, volume, consistency — plus routine and bodyweight logging. Your workout history is never written.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hevy-coach-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gCuadros/hevy-mcp.git"
  },
  "homepage": "https://github.com/gCuadros/hevy-mcp#readme",
  "bugs": "https://github.com/gCuadros/hevy-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hevy",
    "fitness",
    "workout",
    "analytics"
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "yarn build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jose": "^6.2.7",
    "zod": "^4.4.3"
  }
}
