# Copy to .env.local (gitignored) and fill in. Nothing here is read in production —
# hosted deployments set these as real environment variables.

# ---------------------------------------------------------------------------
# Local (stdio) mode — src/stdio.ts
# ---------------------------------------------------------------------------

# Your Hevy API key: Hevy app -> Settings -> API. Requires Hevy PRO.
# Missing: the server refuses to start with a message telling you where to get one.
# Also enables the real-API smoke tests, which skip themselves when it is unset.
HEVY_API_KEY=

# ---------------------------------------------------------------------------
# Remote (HTTP) mode — src/server.ts, src/http.ts
# ---------------------------------------------------------------------------

# Port to listen on. Default 3000.
PORT=3000

# Public HTTPS origin of the deployment, no trailing slash. It is what the OAuth
# metadata advertises as issuer and endpoints.
# Missing in production (NODE_ENV=production): the server throws on the first
# request. Locally it falls back to the request's own host.
PUBLIC_URL=

# 32 random bytes, base64, used to seal the user's Hevy key into OAuth tokens:
#   openssl rand -base64 32
# The suffix is the key id. Add TOKEN_SEALING_KEY_v2 alongside v1 to rotate: every
# loaded key can unseal, only the active one seals, so live tokens keep working.
# Missing: no token can be issued or read, and the whole OAuth flow fails.
TOKEN_SEALING_KEY_v1=

# Which key id seals new tokens. Default v1.
TOKEN_SEALING_ACTIVE_KID=v1

# Comma-separated HTTPS origins allowed as OAuth redirect targets — scheme and host
# only, no path, e.g. https://claude.ai,https://chatgpt.com
# Loopback callbacks (localhost, 127.0.0.1, [::1], any port) are always allowed and
# do not belong in this list.
# Missing: only loopback clients can connect; browser clients get
# "redirect_uri is not approved for this connector".
# Malformed (an entry with a path, or not HTTPS): this is validated per request, not
# at startup, so the process boots and logs "listening" and then answers 500 to
# everything. Do not treat a clean start as proof the config is good — send a request.
OAUTH_TRUSTED_REDIRECT_ORIGINS=
